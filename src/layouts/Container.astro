---
import NavigationBar from "../components/NavigationBar.astro";
---

<!-- Top-level Container -->
<div class="w-2xl h-9/10 border-2 border-zinc-400 border-dotted font-bitcount overflow-hidden">
    <!-- Headers -->
    <div class="w-full flex items-center border-b-2 border-zinc-400 border-dotted">
        <h1 class="ml-2.5 mt-2 mb-2 font-bitcount text-zinc-200 text-4xl">SOLITARJU.UK</h1>
        <a href="https://github.com/Solitarju" target="_blank" rel="noopener noreferrer" class="ml-auto mr-2.5 pl-2.5 border-l-2 border-zinc-300 border-dotted font-bitcount text-zinc-300 text-lg hover:text-sky-300 hover:underline hover:decoration-solid">
            VIEW SOURCE
        </a>
    </div>

    <!-- Top Navigation -->
    <NavigationBar />

    <!-- Child Content -->
    <div class="h-9/10 overflow-y-scroll">
        <slot/>
    </div>
</div>