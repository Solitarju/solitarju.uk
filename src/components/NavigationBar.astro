---
const pattern = Astro.routePattern;
const absoluteStyles = 'w-full pt-1 pb-1 font-bitcount text-zinc-300 text-lg text-center';
const hoverStyles = 'hover:text-zinc-950 hover:bg-zinc-300';
const activeStyles = 'bg-zinc-200 text-zinc-950';
---

<!-- Navigation -->
<div class= "w-full flex justify-evenly border-b-2 border-zinc-400 border-dotted divide-x-2 divide-zinc-400 divide-dotted">
    <a href="/" class:list={[absoluteStyles, { [hoverStyles]: pattern != "/", [activeStyles]: pattern == "/" }]}>Home</a>
    <a href="/about/" class:list={[absoluteStyles, { [hoverStyles]: pattern != "/about", [activeStyles]: pattern == "/about" }]}>About</a>
    <a href="/projects/" class:list={[absoluteStyles, { [hoverStyles]: pattern != "/projects", [activeStyles]: pattern == "/projects" }]}>Projects</a>
    <a href="/blog/" class:list={[absoluteStyles, { [hoverStyles]: pattern != "/blog", [activeStyles]: pattern == "/blog" }]}>Blog</a>
    <a href="/contacts/" class:list={[absoluteStyles, { [hoverStyles]: pattern != "/contacts", [activeStyles]: pattern == "/contacts" }]}>Contacts</a>
</div>